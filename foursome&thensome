  {ax:"EAG", name:"Golf Instructor", why:"Eagerness. How badly you want to get better.",
   opts:[["Box Store Bob",1],["Albert Zapata",2],["Tim Cup",3],["Local Golf Pro",4],
         ["Carl Weathers",6,"gold"],["Butch Harmon",7,"legend"]]},
  {ax:"STY", name:"Clothes", why:"Style. What walks up to the first tee.",
   opts:[["Costgo",1],["Big Mouth",2],["Airness",3],["Malborn",4],
         ["2000s Baggy Khakis + Backwards Kangol",6,"gold"],["Sunday Red",7,"legend"]]},
  {ax:"ENT", name:"Course", why:"Entertainment. Where the day happens.",
   opts:[["Sharkstown",1],["Margarita-land",2],["Gravel Beach",3],["The Oldest Course",4],
         ["Bethpage #0A0A0A",6,"gold"],["August-duh International",7,"legend"]]},
  {ax:"ATH", name:"Transport", why:"Athleticism. How you move for 18 holes.",
   opts:[["Carrying",1],["Push Cart",2],["Golf Cart",3],["Golf Board",4],
         ["Bubba's Hovercraft",6,"gold"],["Caddy Carries",7,"legend"]]},
  {ax:"COM", name:"Clubs", why:"Commitment. What is in the bag.",
