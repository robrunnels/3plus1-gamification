<script>
// [ENGINE-START]
"use strict";

/* ============================== CONFIG (tuning knobs) ============================== */
const CONFIG = {
  title: "Foursome & Then Some",       // the golf skin; the engine is YOU+3
  budget: 15,                          // total points (13 at launch, 14 then 15 per Rob's playtests)
  wBudget: 0.6, wQuiz: 0.4,            // trust spend more than claims
  athWeightPlay: 1.5,                  // Q3 "play" multiplies ATH axis weight
  decadeBonus: 0.6,                    // distance discount for matching decade vibe
  jitter: 0.25,                        // deterministic tie-breaking texture
};
const AXES = ["EAG","STY","ENT","ATH","COM"];

/* ============================== BUDGET CATEGORIES ==============================
   Prices 1-4 map to axis targets 1-5. Gold tier (6) and Legend tier (7) both max the axis.
