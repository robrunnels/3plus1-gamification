  if(prices.some(x=>x>=7)) return "THE LEGEND BUILD";
  if(prices.some(x=>x>=6)) return "THE GOLD BUILD";
  if(Math.max(...prices)-Math.min(...prices)<=1) return "THE BALANCED BUILD";
  if(prices.filter(x=>x<=1).length>=2&&Math.max(...prices)>=4) return "THE SPLURGE BUILD";
  return "YOUR BUILD";
}

function screenBudget(){
  const left=GAME.CONFIG.budget-spent();
  app.innerHTML=`
  <div class="screen" style="padding-top:12px;">
    <div class="meter">
      <div class="row"><span class="brand">Your budget</span><span class="tag" id="bl">${buildLabel()}</span></div>
      <div class="row"><b id="pts">${left}</b><span class="tag">points left of ${GAME.CONFIG.budget}. One pick per category.</span></div>
    </div>
    <div id="cats"></div>
    <button class="btn" id="go" ${Object.keys(S.picks).length===5?"":"disabled"} onclick="startQuiz()">To the questionnaire</button>
  </div>`;
  const cats=document.getElementById("cats");
  GAME.CATEGORIES.forEach(cat=>{
    const div=document.createElement("div"); div.className="cat";
    div.innerHTML=`<h3>${cat.name}</h3><div class="why">${cat.why}</div>`;
    const grid=document.createElement("div"); grid.className="opts";
    cat.opts.forEach(([name,price,tier])=>{
      const b=document.createElement("button");
      b.className="opt"+(tier?" legend":"")+(S.picks[cat.ax]&&S.picks[cat.ax].name===name?" sel":"");
      b.innerHTML=`<span>${tier?'<span class="legendtag">'+(tier==="legend"?"Legend":"Gold")+' tier</span>':""}${name}</span><span class="price">${price} pt${price>1?"s":""}</span>`;
      const cur=S.picks[cat.ax]?S.picks[cat.ax].price:0;
      if(price>GAME.CONFIG.budget-spent()+cur&&!(S.picks[cat.ax]&&S.picks[cat.ax].name===name)) b.disabled=true;
      b.onclick=()=>{const y=app.scrollTop; S.picks[cat.ax]={name,price}; screenBudget(); app.scrollTop=y;};
      grid.appendChild(b);
    });
    div.appendChild(grid); cats.appendChild(div);
  });
}

function startQuiz(){
  const v=GAME.validateBudget(S.picks);
  if(!v.ok){toast(v.msg); return;}
  S.qi=0; S.answers={}; screenQuiz();
  app.scrollTop=0;
}

function screenQuiz(){
  const q=GAME.QUESTIONS[S.qi];
  const dots=GAME.QUESTIONS.map((_,i)=>`<i class="${i<=S.qi?"on":""}"></i>`).join("");
  let body="";
  if(q.type==="scale"){
    body=`<div class="scale">${[1,2,3,4,5].map(n=>`<button onclick="answer('${q.id}',${n})">${n}</button>`).join("")}</div>
    <div class="anchors"><span>${q.lo}</span><span>${q.hi}</span></div>`;
  }else{
    body=`<div class="mc">${q.opts.map(([label,val])=>`<button class="opt" onclick="answer('${q.id}','${val}')"><span>${label}</span></button>`).join("")}</div>`;
  }
  app.innerHTML=`
  <div class="screen">
    <div class="q-progress">${dots}</div>
    <div class="brand">Question ${S.qi+1} of ${GAME.QUESTIONS.length}</div>
    <h2 style="margin-top:8px;">${q.q}</h2>
    ${body}
  </div>`;
}

function answer(id,val){
  S.answers[id]=val; S.qi++;
  if(S.qi<GAME.QUESTIONS.length) screenQuiz(); else screenReveal();
  app.scrollTop=0;
}

function screenReveal(){
  app.innerHTML=`
  <div class="screen"><div class="reveal">
    <div class="spinner"></div>
    <h2>Assembling your foursome</h2>
    <p class="sub">Checking politics gates. Capping loudmouths. Consulting the Colonel.</p>
  </div></div>`;
  setTimeout(screenResults,1400);
}

function screenResults(){
  const r=GAME.playRound(S.picks,S.answers);
  const cards=r.four.map((c,i)=>`
    <div class="fcard" style="animation-delay:${i*0.18}s">
      <span class="wing ${c.w}">${c.w}</span><h3>${c.n}</h3><p>${c.hook}</p>
    </div>`).join("");
  const crasher=r.crasher?`
    <div class="fcard lebron" style="animation-delay:0.72s">
      <span class="wing" style="background:var(--gold); color:var(--green);">SPECIAL</span>
      <h3>${r.crasher.n}</h3><p>${r.crasher.card}</p>
    </div>`:"";
  app.innerHTML=`
  <div class="screen">
    <div class="brand">Your foursome</div>
    <h2>See you on the first tee.</h2>
    ${cards}
    <div class="fcard you" style="animation-delay:0.54s"><span class="wing" style="background:var(--green);">You</span><h3>You</h3><p>The architect of everything that follows.</p></div>
    ${crasher}
    <div class="recap">
      <h4>The round that never happened</h4>
      <p>${r.recap}</p>
      <div class="rating">${r.rating}/10</div>
    </div>
    <div class="coach">Coached by ${r.instructor}. ${r.crasher?"Crashed by "+r.crasher.n+".":""}</div>
    <button class="btn gold" onclick="share(${JSON.stringify(r.share).replace(/"/g,"&quot;")})">Share this foursome</button>
    <button class="btn ghost" onclick="replay()">Run it back</button>
    <div class="foot">Built on YOU+3. All brands lovingly parodied.</div>
  </div>`;
  app.scrollTop=0;
}

function share(text){
  if(navigator.share){navigator.share({text}).catch(()=>{});}
  else if(navigator.clipboard){navigator.clipboard.writeText(text).then(()=>toast("Copied. Go brag."));}
  else toast(text);
}

function replay(){S={picks:{},answers:{},qi:0}; screenBudget(); app.scrollTop=0;}

screenIntro();
</script>
</body>
</html>
