/* ============================== ENGINE ============================== */
/* Session memory: never reuse an opening or incident until the whole pool has been heard.
   Kills repeats during pass-the-phone demos. Resets on page reload. */
const USED={op:new Set(), inc:new Set(), cr:new Set(), cam:new Set()};
function pickFresh(arr, used, rng){
  let pool=arr.filter(x=>!used.has(x));
  if(!pool.length){used.clear(); pool=arr.slice();}
  const x=pool[Math.floor(rng()*pool.length)];
  used.add(x); return x;
}

function hashStr(s){let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619);}return h>>>0;}
function mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
function priceToAxis(p){return p>=6?5:1+(p-1)*4/3;} // gold (6) and legend (7) both max the axis

/* picks: {EAG:{name,price}, STY:{...}, ...}   answers: {decade, politics, playwatch, turn, EAG..COM, chirp} */
function validateBudget(picks){
  const cats=Object.keys(picks||{});
  if(cats.length!==5) return {ok:false, msg:"Pick one option in every category."};
  const spend=cats.reduce((s,k)=>s+picks[k].price,0);
  if(spend>CONFIG.budget) return {ok:false, msg:"Over budget."};
  return {ok:true, spend, left:CONFIG.budget-spend};
}

function runMatch(picks, answers){
  const key=JSON.stringify([Object.keys(picks).sort().map(k=>picks[k].name), answers]);
  const seed=hashStr(key);
  const rng=mulberry32(seed);
  const pick=arr=>arr[Math.floor(rng()*arr.length)];

  // player vector: blend spend (trusted more) with claims
  const player={}, weights={};
  AXES.forEach((ax,i)=>{
    const b=priceToAxis(picks[ax].price);
    const q=answers[ax];
    player[ax]=CONFIG.wBudget*b+CONFIG.wQuiz*q;
    weights[ax]=1;
  });
  if(answers.playwatch==="play") weights.ATH=CONFIG.athWeightPlay;

  // gate first, then score
  let pool=CELEBS.filter(c=>!(answers.politics==="never"&&c.pol));
  const scored=pool.map(c=>{
    let d=0;
    AXES.forEach((ax,i)=>{d+=weights[ax]*Math.abs(player[ax]-c.v[i]);});
    if(c.dec===answers.decade) d-=CONFIG.decadeBonus;
    d+=(hashStr(c.n+key)%1000)/1000*CONFIG.jitter;
    return {c,d};
  }).sort((a,b)=>a.d-b.d);

  // curation: max one loudmouth (zero if chirp answer is 1-2), max two per wing
  const maxLoud=answers.chirp<=2?0:1;
  const four=[], wingCt={}; let loud=0;
  for(const {c} of scored){
    if(four.length===3) break;
    if(c.lm&&loud>=maxLoud) continue;
    if((wingCt[c.w]||0)>=2) continue;
    four.push(c); wingCt[c.w]=(wingCt[c.w]||0)+1; if(c.lm) loud++;
  }
  for(const {c} of scored){ // safety fill, loudmouth cap stays hard
    if(four.length===3) break;
    if(four.includes(c)) continue;
    if(c.lm&&loud>=maxLoud) continue;
    four.push(c); if(c.lm) loud++;
  }

  const lebron=picks.EAG.price>=4&&answers.playwatch==="watch";

  const bi=scored.find(s=>s.c.w==="Icons"&&!four.includes(s.c));
  return {four, lebron, seed, rng, pick, key, bestInvestor:bi&&bi.c,
          instructor:picks.EAG.name,
          spend:AXES.reduce((s,ax)=>s+picks[ax].price,0), picks, answers};
}

/* Decide the round's uninvited guest, if any. Called once per play. */
function resolveCrasher(m){
  SESSION.plays++;
  const hasInvestor=m.four.some(c=>c.w==="Icons");
  if(hasInvestor) SESSION.investorPlays++;
  // LeBron trigger keeps absolute priority
  if(m.lebron){SESSION.crasherless=0; return {n:LEBRON.n, card:LEBRON.card, lebron:true};}
  // Icon guarantee: an Icons-wing member appears by your second play, one max per foursome
  if(!hasInvestor&&SESSION.plays>=2&&SESSION.investorPlays===0&&m.bestInvestor){
    SESSION.investorPlays++; SESSION.crasherless=0;
    return {n:m.bestInvestor.n,
      card:m.bestInvestor.n+" rolled up on the back nine, decided the group needed adult supervision, and joined uninvited."};
  }
  // Themed crashers: behavior-triggered, roughly every third play, session no-repeat
  const elig=CRASHERS.filter(c=>c.when(m)&&!USED.cr.has(c.n));
  if(elig.length&&(m.rng()<0.38||SESSION.crasherless>=2)){
    const c=elig[Math.floor(m.rng()*elig.length)];
    USED.cr.add(c.n); SESSION.crasherless=0;
    return {n:c.n, card:c.card, taft:c.taft};
  }
  SESSION.crasherless++;
  return null;
}

function buildRecap(m, cr){
  const {four, answers, picks, pick, rng}=m;
  const names=four.map(c=>c.n);
  const parts=[pickFresh(RECAP_LIB.openings, USED.op, rng)];

  // celebrity beats, one per member
  const beats=four.map(c=>pick(c.ev));

  if(INSTRUCTOR_BEATS[picks.EAG.name]&&rng()<0.85){parts.push(INSTRUCTOR_BEATS[picks.EAG.name]);}

  // legend-tier gear beats (Sunday Red, the hovercraft, and friends)
  AXES.forEach(ax=>{
    if(ax!=="EAG"&&picks[ax].price>=6){
      const b=LEGEND_GEAR_BEATS[picks[ax].name];
      if(b) parts.push(typeof b==="function"?b(m):b);
    }
  });

  // one pair beat max
  const pairs=PAIR_BEATS.filter(p=>names.includes(p[0])&&names.includes(p[1]));
  const pairBeat=pairs.length?pick(pairs)[2]:null;

  // turn joke, Colonel-aware
  let turn=RECAP_LIB.turn[answers.turn];
  if(answers.turn==="hotdog") turn=names.includes("Colonel Sanders")?RECAP_LIB.turn.hotdogIn:RECAP_LIB.turn.hotdogAfar;

  parts.push(beats[0]);
  if(pairBeat) parts.push(pairBeat);
  parts.push(turn, beats[1], pickFresh(RECAP_LIB.incidents, USED.inc, rng), beats[2]);

  // a sighting around the course, sometimes
  const camPool=CAMEOS.filter(c=>!(answers.politics==="never"&&c.pol));
  if(rng()<0.6){parts.push(pickFresh(camPool, USED.cam, rng).line);}

  // the Daly and Taft duel survives the coach swap: it now fires when Daly crashes onto Taft's round
  if(cr&&cr.taft&&names.includes("William Taft")) parts.push(cr.taft);

  const v=validateBudget(picks);
  if(v.left>=2) parts.push(RECAP_LIB.thrift.replace("{x}",v.left));
  if(picks.EAG.price>=6&&picks.STY.price<=1&&picks.ATH.price<=2) parts.push(RECAP_LIB.legendBuild);
  if(cr) parts.push("Also, "+cr.n+" showed up uninvited. The card above explains as much as can be explained.");

  // rating: loudmouths and beer runs cost you, deterministically
  let rating=10;
  if(four.some(c=>c.lm)) rating-=1;
  if(answers.turn==="beer") rating-=1;
  if(rng()<0.5) rating-=1;
  rating=Math.max(7,rating);
  const signoff=pick(rating>=9?RECAP_LIB.signoffsHigh:RECAP_LIB.signoffsLow);
  parts.push(`Overall ${rating}/10 round. ${signoff}`);

  return {text:parts.join(" "), rating};
}

function playRound(picks, answers){
  const m=runMatch(picks, answers);
  const cr=resolveCrasher(m);
  const recap=buildRecap(m, cr);
  const share=`I built my dream foursome: ${m.four.map(c=>c.n).join(", ")}, and me. ${recap.rating}/10 round. ${CONFIG.title}.`;
  return {four:m.four, crasher:cr, lebron:!!(cr&&cr.lebron), recap:recap.text, rating:recap.rating, share, instructor:m.instructor};
}

const GAME={CONFIG,AXES,CATEGORIES,QUESTIONS,CELEBS,LEBRON,CRASHERS,CAMEOS,validateBudget,playRound,runMatch,buildRecap,
  _clearUsed:()=>{USED.op.clear();USED.inc.clear();USED.cr.clear();USED.cam.clear();},
  _resetSession:()=>{USED.op.clear();USED.inc.clear();USED.cr.clear();USED.cam.clear();
    SESSION.plays=0;SESSION.investorPlays=0;SESSION.crasherless=0;}};
if(typeof module!=="undefined") module.exports=GAME;
// [ENGINE-END]
</script>
